# Base de datos (contenedor docker-compose del repositorio)
DATABASE_URL="postgresql://dashboard:dashboard@localhost:5433/karen_dashboard?schema=public"

# API
PORT=3000
CORS_ORIGIN="http://localhost:4200"

# URL publica del frontend. Se usa para armar los enlaces de los correos.
APP_URL="http://localhost:4200"

# Autenticacion (RF01)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Politica de seguridad (RNF03)
MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15

# --------------------------------------------------------------------------
# Notificaciones por correo (RF09 y RF14)
# --------------------------------------------------------------------------
# Sin credenciales, los correos NO se envian: se escriben completos en el log
# del servidor. El proyecto se puede desarrollar y sustentar asi.
#
# Para enviar de verdad hay dos opciones gratuitas; basta configurar UNA.
#
# Opcion A - Gmail (la mas rapida, 500 correos/dia, no requiere registrarse en
# ningun servicio nuevo). En la cuenta de Google: activar la verificacion en dos
# pasos y crear una "Contrasena de aplicacion" en
# https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Opcion B - Brevo (API HTTP, 300 correos/dia). Registrarse gratis en
# https://www.brevo.com, verificar el correo remitente (puede ser el mismo
# Gmail) y copiar la clave de https://app.brevo.com/settings/keys/api
# Es la opcion recomendada en despliegue: no usa puertos SMTP, que muchos
# proveedores de hosting bloquean.
BREVO_API_KEY=""

# Remitente que veran los destinatarios. Con Gmail se puede dejar vacio (se usa
# GMAIL_USER); con Brevo debe ser el correo verificado en su panel.
CORREO_REMITENTE=""
CORREO_NOMBRE="Seguimiento Académico"

# Opcional: fuerza un proveedor concreto (brevo | smtp | log). Vacio = se elige
# automaticamente segun las variables disponibles. `log` sirve para desactivar
# el envio real sin borrar las credenciales.
CORREO_PROVEEDOR=""

# Opcion C - cualquier otro servidor SMTP.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="alertas@dashboard-academico.edu.co"

# Destinatario del escalamiento automatico de alertas de riesgo alto (RF13) y
# copia de las solicitudes de retiro (RF14). Bienestar Universitario no tiene
# usuario en el sistema: recibe correo.
BIENESTAR_EMAIL="bienestar@dashboard.edu.co"

# Directivos que reciben copia de cada solicitud de retiro (RF14), separados por
# coma. Son cuentas sin usuario en el sistema, como Registro y Control.
DIRECTIVOS_EMAIL="direccion.academica@dashboard.edu.co,registro@dashboard.edu.co"
