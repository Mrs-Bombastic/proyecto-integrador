# Base de datos (contenedor docker-compose del repositorio)
DATABASE_URL="postgresql://dashboard:dashboard@localhost:5433/karen_dashboard?schema=public"

# API
PORT=3000
CORS_ORIGIN="http://localhost:4200"

# Autenticacion (RF01)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Politica de seguridad (RNF03)
MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15

# Notificaciones por correo (RF09). Dejar SMTP_HOST vacio para simular el envio
# escribiendo en consola en lugar de enviar correos reales.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="alertas@dashboard-academico.edu.co"

# Destinatario del escalamiento automatico de alertas de riesgo alto (RF13).
# Bienestar Universitario no tiene usuario en el sistema: recibe correo.
BIENESTAR_EMAIL="bienestar@dashboard.edu.co"
